{
  "rules": {
    "farmer_intakes": {
      ".indexOn": ["user_id", "status"],
      "$push_id": {
        ".read": "auth != null && (data.child('user_id').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (!data.exists() || data.child('user_id').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['user_id', 'data', 'status'])"
      }
    },
    "donations": {
      ".indexOn": ["status", "phone", "CheckoutRequestID"],
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$push_id": {
        // Allow public STK initiation to write a pending record
        ".write": "!data.exists() && newData.child('status').val() === 'pending'",
        // Only admin or the system (callback) should update existing records
        ".validate": "newData.hasChildren(['phone', 'amount', 'status', 'timestamp'])"
      }
    },
    "research_insights": {
      ".read": true, // Publicly accessible reports
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$report_id": {
        ".validate": "newData.hasChildren(['title', 'category', 'url', 'timestamp'])"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },
    "admins": {
      ".read": "auth != null && data.child(auth.uid).exists()",
      ".write": false 
    },
    "public_stats": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    ".read": false,
    ".write": false
  }
}
